{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "prefix": {
      "type": "string",
      "defaultValue": "entrelinhas-sql"
    },
    "suffix": {
      "type": "string",
      "defaultValue": "ckenz0"
    },
    "location": {
      "type": "string",
      "defaultValue": "brazilsouth"
    },
    "frontendLocation": {
      "type": "string",
      "defaultValue": "centralus"
    },
    "secretKey": {
      "type": "securestring",
      "minLength": 32
    },
    "postgresAdminPassword": {
      "type": "securestring",
      "minLength": 16
    },
    "databasePassword": {
      "type": "securestring",
      "minLength": 16
    },
    "adminIp": {
      "type": "string"
    }
  },
  "variables": {
    "pgName": "[concat(parameters('prefix'), '-pg-', parameters('suffix'))]",
    "apiName": "[concat(parameters('prefix'), '-api-', parameters('suffix'))]",
    "frontName": "[concat(parameters('prefix'), '-front-', parameters('suffix'))]",
    "planName": "[concat(parameters('prefix'), '-plan')]"
  },
  "resources": [
    {
      "type": "Microsoft.DBforPostgreSQL/flexibleServers",
      "apiVersion": "2024-08-01",
      "name": "[variables('pgName')]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "Standard_B1ms",
        "tier": "Burstable"
      },
      "properties": {
        "version": "17",
        "administratorLogin": "entrelinhasadmin",
        "administratorLoginPassword": "[parameters('postgresAdminPassword')]",
        "storage": {
          "storageSizeGB": 32,
          "autoGrow": "Disabled"
        },
        "backup": {
          "backupRetentionDays": 7,
          "geoRedundantBackup": "Disabled"
        },
        "highAvailability": {
          "mode": "Disabled"
        },
        "network": {
          "publicNetworkAccess": "Enabled"
        },
        "authConfig": {
          "activeDirectoryAuth": "Disabled",
          "passwordAuth": "Enabled"
        }
      }
    },
    {
      "type": "Microsoft.DBforPostgreSQL/flexibleServers/databases",
      "apiVersion": "2024-08-01",
      "name": "[concat(variables('pgName'), '/entrelinhas')]",
      "dependsOn": [
        "[resourceId('Microsoft.DBforPostgreSQL/flexibleServers',variables('pgName'))]"
      ],
      "properties": {
        "charset": "UTF8",
        "collation": "en_US.utf8"
      }
    },
    {
      "type": "Microsoft.DBforPostgreSQL/flexibleServers/firewallRules",
      "apiVersion": "2024-08-01",
      "name": "[concat(variables('pgName'), '/AzureServices')]",
      "dependsOn": [
        "[resourceId('Microsoft.DBforPostgreSQL/flexibleServers',variables('pgName'))]"
      ],
      "properties": {
        "startIpAddress": "0.0.0.0",
        "endIpAddress": "0.0.0.0"
      }
    },
    {
      "type": "Microsoft.DBforPostgreSQL/flexibleServers/firewallRules",
      "apiVersion": "2024-08-01",
      "name": "[concat(variables('pgName'), '/AdminCurrentIp')]",
      "dependsOn": [
        "[resourceId('Microsoft.DBforPostgreSQL/flexibleServers',variables('pgName'))]"
      ],
      "properties": {
        "startIpAddress": "[parameters('adminIp')]",
        "endIpAddress": "[parameters('adminIp')]"
      }
    },
    {
      "type": "Microsoft.Web/serverfarms",
      "apiVersion": "2023-12-01",
      "name": "[variables('planName')]",
      "location": "[parameters('location')]",
      "kind": "linux",
      "sku": {
        "name": "F1",
        "tier": "Free",
        "capacity": 1
      },
      "properties": {
        "reserved": true
      }
    },
    {
      "type": "Microsoft.Web/staticSites",
      "apiVersion": "2023-12-01",
      "name": "[variables('frontName')]",
      "location": "[parameters('frontendLocation')]",
      "sku": {
        "name": "Free",
        "tier": "Free"
      },
      "properties": {}
    },
    {
      "type": "Microsoft.Web/sites",
      "apiVersion": "2023-12-01",
      "name": "[variables('apiName')]",
      "location": "[parameters('location')]",
      "kind": "app,linux",
      "dependsOn": [
        "[resourceId('Microsoft.Web/serverfarms',variables('planName'))]",
        "[resourceId('Microsoft.Web/staticSites',variables('frontName'))]",
        "[resourceId('Microsoft.DBforPostgreSQL/flexibleServers/databases',variables('pgName'),'entrelinhas')]"
      ],
      "properties": {
        "httpsOnly": true,
        "serverFarmId": "[resourceId('Microsoft.Web/serverfarms',variables('planName'))]",
        "siteConfig": {
          "linuxFxVersion": "PYTHON|3.12",
          "appCommandLine": "bash startup.sh",
          "alwaysOn": false,
          "minTlsVersion": "1.2",
          "ftpsState": "Disabled",
          "appSettings": [
            {
              "name": "APP_ENV",
              "value": "production"
            },
            {
              "name": "STORAGE_BACKEND",
              "value": "postgresql"
            },
            {
              "name": "SECRET_KEY",
              "value": "[parameters('secretKey')]"
            },
            {
              "name": "ALLOWED_ORIGINS",
              "value": "[concat('https://',reference(resourceId('Microsoft.Web/staticSites',variables('frontName')),'2023-12-01').defaultHostname)]"
            },
            {
              "name": "DATABASE_URL",
              "value": "[concat('postgresql+psycopg://entrelinhas_app:',uriComponent(parameters('databasePassword')),'@',reference(resourceId('Microsoft.DBforPostgreSQL/flexibleServers',variables('pgName')),'2024-08-01').fullyQualifiedDomainName,':5432/entrelinhas?sslmode=require')]"
            },
            {
              "name": "SCM_DO_BUILD_DURING_DEPLOYMENT",
              "value": "true"
            }
          ]
        }
      }
    }
  ],
  "outputs": {
    "frontendUrl": {
      "type": "string",
      "value": "[concat('https://',reference(resourceId('Microsoft.Web/staticSites',variables('frontName')),'2023-12-01').defaultHostname)]"
    },
    "apiUrl": {
      "type": "string",
      "value": "[concat('https://',reference(resourceId('Microsoft.Web/sites',variables('apiName')),'2023-12-01').defaultHostName)]"
    },
    "postgresHost": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.DBforPostgreSQL/flexibleServers',variables('pgName')),'2024-08-01').fullyQualifiedDomainName]"
    }
  }
}
