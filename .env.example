# Copie para .env na raiz. Configuração somente do servidor.
APP_ENV=development
STORAGE_BACKEND=postgresql
DATABASE_URL=postgresql+psycopg://entrelinhas:entrelinhas-local@127.0.0.1:5433/entrelinhas
# Defina uma chave aleatória estável para preservar a sessão após reiniciar.
SECRET_KEY=
ALLOWED_ORIGINS=http://127.0.0.1:8081,http://localhost:8081
PORT=5001
